NET "MAINCLK" TNM_NET = MAINCLK;
TIMESPEC TS_MAINCLK = PERIOD "MAINCLK" 26 MHz HIGH 50%;
NET "MAINCLK" BUFG=CLK; 
NET "MAINCLK" LOC=P15;

NET "TST7" LOC=P63;
NET "TST6" LOC=P64;

# External clock for Turbo Mode
NET "CLK_EXT" LOC=P43;

NET "Z80CLK_n" LOC=P7;

NET "IORQ_n" LOC=P62;
