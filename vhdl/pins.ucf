NET "RD_n" LOC=P61;
NET "WR_n" LOC=P2;

NET "RAMCS_n" LOC=P5;
NET "ROMCS_n" LOC=P6;
NET "RAMCS_n" SLOW;
NET "ROMCS_n" SLOW;
NET "VIDEO" LOC=P17;
NET "nTAPEIN" LOC=P22;

NET "M1_n" LOC=P9;
NET "HALT_n" LOC=P18;
NET "NMI_n" LOC=P16;

# Resonnator input not used - should be Low by default >>> Used for A13
NET "Ah(13)" LOC=P48;

# US/UK not used (UK->Floating, internal PU) >>> Used for WAIT signal (Normal or NoWait)
NET "WAIT_n" LOC=P36;

